# Postgres connection string (Railway provisions this automatically in
# production - only needed manually for local dev, see whiffers/scripts/
# cross-tables-db/README.md for the schema this expects).
DATABASE_URL=postgresql://user:pass@host:port/dbname

# Optional - defaults to 4000.
PORT=4000

# Shared "temp password" required to POST /registry (upload a game into the
# internal registry). Not a per-user account system - one secret, checked
# with a constant-time compare. Pick something you'd hand out to trusted
# uploaders, not a real per-account credential.
UPLOAD_PASSWORD=change-me
